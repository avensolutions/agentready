---
import CheckCard from './CheckCard.astro';
import ScoreBar from './ScoreBar.astro';

/**
 * @typedef {Object} Props
 * @property {import('../../lib/scan/run.js').ReportDimension} dimension
 * @property {number} index  1-based, for the eyebrow number
 */
const { dimension, index } = Astro.props;
const num = String(index).padStart(2, '0');
const partial = dimension.assessed < dimension.total;
---
<section class="dimension" id={`dimension-${dimension.id}`} aria-labelledby={`dimension-${dimension.id}-title`}>
  <header class="dimension-head">
    <div class="dimension-title">
      <span class="eyebrow"><span class="num">{num}</span><span class="label">Weight {dimension.weight}</span></span>
      <h2 id={`dimension-${dimension.id}-title`}>{dimension.title}</h2>
      <p class="support">{dimension.description}</p>
    </div>
    <div class="dimension-score">
      <div class="figure">{dimension.score === null ? '-' : dimension.score}<span class="of"> / 100</span></div>
      <div class="band">{dimension.band.label}</div>
      <ScoreBar score={dimension.score} band={dimension.band} />
      {partial && <p class="partial">{dimension.assessed} of {dimension.total} checks assessed</p>}
      {dimension.total === 0 && <p class="partial">No checks in this area apply to this kind of site.</p>}
    </div>
  </header>
  <div class="checks">
    {dimension.checks.map((check) => <CheckCard check={check} />)}
  </div>
</section>

<style>
  .dimension {
    padding: 64px 0 24px;
  }
  .dimension-head {
    display: grid;
    grid-template-columns: 1fr 220px;
    gap: 32px 56px;
    align-items: start;
    margin-bottom: 28px;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--hairline);
    border-radius: var(--r-pill);
    padding: 7px 18px;
    margin-bottom: 20px;
  }
  .eyebrow .num {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    color: var(--olive);
  }
  .dimension h2 {
    font-size: clamp(26px, 2.8vw, 36px);
    max-width: 22ch;
  }
  .dimension .support {
    margin-top: 14px;
    max-width: 64ch;
    font-size: var(--text-base);
  }
  .dimension-score {
    padding: 22px 24px 24px;
    background: var(--surface);
    border-radius: var(--r-lg);
  }
  .figure {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--text-stat);
    letter-spacing: -0.03em;
    line-height: 1;
  }
  .figure .of {
    font-size: var(--text-small);
    font-weight: 500;
    letter-spacing: 0;
    color: var(--ink-muted);
  }
  .band {
    margin: 8px 0 14px;
    font-size: var(--text-label);
    font-weight: 500;
    letter-spacing: var(--tracking-label);
    text-transform: uppercase;
    color: var(--ink-muted);
  }
  .partial {
    margin-top: 10px;
    font-size: var(--text-fine);
    color: var(--ink-muted);
  }
  .checks { border-bottom: 1px solid var(--hairline); }

  @media (max-width: 768px) {
    .dimension { padding-top: 48px; }
    .dimension-head { grid-template-columns: 1fr; gap: 20px; }
  }
</style>
