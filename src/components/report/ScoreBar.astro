---
/**
 * A thin bar for a 0 to 100 score, filled in the band colour. Small marks
 * and bars are the only place the accent colours appear.
 * @typedef {Object} Props
 * @property {number | null} score
 * @property {{ id: string, label: string }} band
 * @property {number} [max]
 */
const { score, band, max = 100 } = Astro.props;
const pct = score === null ? 0 : Math.max(0, Math.min(100, Math.round((score / max) * 100)));
---
<div class={`score-bar band-${band.id}`} role="img" aria-label={score === null ? 'Not assessed' : `${score} out of ${max}`}>
  <span class="fill" style={`width: ${pct}%`}></span>
</div>

<style>
  .score-bar {
    height: 6px;
    background: var(--surface-2);
    border-radius: var(--r-pill);
    overflow: hidden;
  }
  .fill {
    display: block;
    height: 100%;
    background: var(--ink-muted);
    border-radius: var(--r-pill);
  }
  .band-strong .fill { background: var(--score-strong); }
  .band-fair .fill { background: var(--score-fair); }
  .band-weak .fill { background: var(--score-weak); }
  .band-poor .fill { background: var(--score-poor); }
</style>
