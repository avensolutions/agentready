{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agentready",
  "main": "@astrojs/cloudflare/entrypoints/server",
  // The highest date the workerd bundled with @cloudflare/vitest-pool-workers
  // supports. Tests and production share it so behaviour cannot drift; bump
  // both when the pool updates.
  "compatibility_date": "2026-08-22",
  // nodejs_compat is on by default for compatibility dates from 2026-08-04.
  // global_fetch_strictly_public makes fetch() to the parent site behave like
  // any public request (see docs/limits.md).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  // Keeps workers.dev preview URLs on so Workers Builds can give every branch
  // a Preview (see docs/deploy.md, "Branch previews"). Production itself stays
  // on the custom domain once `workers_dev: false` and `routes` are set.
  "preview_urls": true,
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "REPORT_TTL_DAYS": "7"
  },
  "kv_namespaces": [
    {
      "binding": "REPORTS",
      // Local dev simulates the namespace under .wrangler/state. Replace with
      // the real id from `npx wrangler kv namespace create REPORTS` before deploy.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  // Per-IP brake on the scan endpoint: 6 scan requests per 60 seconds.
  // Counted per Cloudflare location; Turnstile is the main gate.
  "ratelimits": [
    {
      "name": "SCAN_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    }
  ],
  // Branch previews. Workers Builds runs `wrangler preview` for every branch
  // other than main and serves it at <branch>-agentready.<subdomain>.workers.dev.
  // A Preview takes its vars and bindings from this block, not from the
  // top-level settings, and its secrets from the Previews base config
  // (`npx wrangler preview base-config secret put`). Preview scans store
  // their reports in a separate namespace with a short TTL so they never
  // appear on production report pages. The rate limiting binding is not
  // part of a Preview; the scan endpoint runs unlimited without it and
  // Turnstile remains the gate.
  "previews": {
    "vars": {
      "GEMINI_MODEL": "gemini-3.5-flash-lite",
      "REPORT_TTL_DAYS": "1"
    },
    "kv_namespaces": [
      {
        "binding": "REPORTS",
        // Replace with the id from `npx wrangler kv namespace create REPORTS_PREVIEW`.
        "id": "REPLACE_WITH_PREVIEW_KV_NAMESPACE_ID"
      }
    ]
  }
  // Custom domain, once theoverstorygroup.com is a zone in this account:
  // "routes": [{ "pattern": "agentready.theoverstorygroup.com", "custom_domain": true }]
}
