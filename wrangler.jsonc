{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "axcheck",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-30",
  // nodejs_compat is on by default for compatibility dates from 2026-08-04.
  // global_fetch_strictly_public makes fetch() to the parent site behave like
  // any public request (see docs/limits.md).
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    "REPORT_TTL_DAYS": "7"
  },
  "kv_namespaces": [
    {
      "binding": "REPORTS",
      // Local dev simulates the namespace under .wrangler/state. Replace with
      // the real id from `npx wrangler kv namespace create REPORTS` before deploy.
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
