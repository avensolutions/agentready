# Copy to .dev.vars (git-ignored). Local development values only.
# Production secrets are set with `npx wrangler secret put <NAME>`.

# Google Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare Turnstile secret. This value is the documented test secret that
# always passes; it is only valid with the matching test site key.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Use the deterministic mock assessor instead of Gemini (no key needed).
# Remove or set to gemini to call the real model.
LLM_PROVIDER=mock

# Optional Gemini limit alerts. Leave blank to avoid sending email locally.
# The recipient must be a verified Cloudflare Email Routing destination.
ALERT_EMAIL_ACCOUNT_ID=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_API_TOKEN=
